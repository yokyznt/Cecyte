<?xml version="1.0" encoding="utf-8"?>
<!-- Widget grande: ahora y sigue. Los ids los llena HorarioWidget.refrescar -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_fondo">

    <TextView
        android:id="@+id/w_grupo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/widget_tenue"
        android:textSize="12sp"
        android:textStyle="bold"
        android:maxLines="1" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/widget_ahora"
        android:textColor="@color/widget_acento"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/w_ahora"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/widget_texto"
        android:textSize="18sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/w_ahora_det"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/widget_tenue"
        android:textSize="13sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/widget_sigue"
        android:textColor="@color/widget_acento"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/w_sigue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/widget_texto"
        android:textSize="15sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/w_sigue_det"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/widget_tenue"
        android:textSize="12sp"
        android:maxLines="1"
        android:ellipsize="end" />
</LinearLayout>
